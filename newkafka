## ✅ Upgraded KafkaConsumerWorker.cs

✔ Secure INSERT using parameters
✔ JSON schema enforcement
✔ Dead letter topic producer
✔ Exception-based retry

```csharp
using Confluent.Kafka;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Configuration;
using System.Data.SqlClient;
using System.Text.Json;
using System.Threading;
using System.Threading.Tasks;
using System.Collections.Generic;

public class KafkaConsumerWorker : BackgroundService
{
    private readonly ILogger<KafkaConsumerWorker> _logger;
    private readonly IConfiguration _configuration;
    private readonly string _connectionString;
    private readonly string _tableName;
    private readonly string _topic;
    private readonly string _deadLetterTopic;
    private readonly string _groupId;
    private readonly string _bootstrapServers;

    public KafkaConsumerWorker(ILogger<KafkaConsumerWorker> logger, IConfiguration configuration)
    {
        _logger = logger;
        _configuration = configuration;

        _connectionString = _configuration.GetConnectionString("DbConnection");
        _tableName = _configuration["Database:TableName"];

        var kafkaConfig = _configuration.GetSection("Kafka");
        _topic = kafkaConfig["Topic"];
        _deadLetterTopic = kafkaConfig["DeadLetterTopic"];
        _groupId = kafkaConfig["GroupId"];
        _bootstrapServers = kafkaConfig["BootstrapServers"];
    }

    protected override Task ExecuteAsync(CancellationToken stoppingToken)
    {
        return Task.Run(async () =>
        {
            var consumerConfig = new ConsumerConfig
            {
                BootstrapServers = _bootstrapServers,
                GroupId = _groupId,
                AutoOffsetReset = AutoOffsetReset.Earliest,
                EnableAutoCommit = false // We commit manually after success
            };

            var producerConfig = new ProducerConfig
            {
                BootstrapServers = _bootstrapServers
            };

            using var consumer = new ConsumerBuilder<Ignore, string>(consumerConfig).Build();
            using var producer = new ProducerBuilder<Null, string>(producerConfig).Build();

            consumer.Subscribe(_topic);
            _logger.LogInformation($"Consumer Running | Topic: {_topic}");

            while (!stoppingToken.IsCancellationRequested)
            {
                try
                {
                    var result = consumer.Consume(stoppingToken);
                    string message = result.Message.Value;
                    _logger.LogInformation($"Received: {message}");

                    bool success = await ProcessMessage(message);

                    if (success)
                    {
                        consumer.Commit(result);
                        _logger.LogInformation("Message committed ✅");
                    }
                    else
                    {
                        await producer.ProduceAsync(_deadLetterTopic, new Message<Null, string> { Value = message });
                        _logger.LogWarning("Message sent to DLQ ⚠️");
                    }
                }
                catch (Exception ex)
                {
                    _logger.LogError($"Critical Error ❌: {ex.Message}");
                }
            }

            consumer.Close();
        }, stoppingToken);
    }

    private async Task<bool> ProcessMessage(string jsonData)
    {
        try
        {
            using JsonDocument doc = JsonDocument.Parse(jsonData);
            var root = doc.RootElement;

            if (root.ValueKind != JsonValueKind.Object)
            {
                _logger.LogWarning("Invalid JSON — not an object ❌");
                return false;
            }

            var columns = new List<string>();
            var parameters = new List<string>();
            var sqlParams = new List<SqlParameter>();

            foreach (var prop in root.EnumerateObject())
            {
                string column = prop.Name;
                object value = prop.Value.ValueKind switch
                {
                    JsonValueKind.String => prop.Value.GetString(),
                    JsonValueKind.Number => prop.Value.GetDouble(),
                    JsonValueKind.True => true,
                    JsonValueKind.False => false,
                    _ => null
                };

                if (value != null)
                {
                    string paramName = "@p" + sqlParams.Count;
                    columns.Add($"[{column}]");
                    parameters.Add(paramName);
                    sqlParams.Add(new SqlParameter(paramName, value));
                }
            }

            if (columns.Count == 0)
            {
                _logger.LogWarning("Empty JSON. Skip.");
                return false;
            }

            string query =
                $"INSERT INTO {_tableName} ({string.Join(",", columns)}) VALUES ({string.Join(",", parameters)})";

            using var conn = new SqlConnection(_connectionString);
            using var cmd = new SqlCommand(query, conn);
            cmd.Parameters.AddRange(sqlParams.ToArray());

            await conn.OpenAsync();
            await cmd.ExecuteNonQueryAsync();

            _logger.LogInformation("Insert Success ✅");
            return true;
        }
        catch (Exception ex)
        {
            _logger.LogError($"Insert Failed ❌: {ex.Message}");
            return false;
        }
    }
}
